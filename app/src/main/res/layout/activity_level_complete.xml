<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- Procent na górze -->
    <TextView
        android:id="@+id/tvPercent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="85%"
        android:textSize="48sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/button_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <!-- Guideline - ta sama wysokość co w ekranie pytania (gdzie był LEVEL 1) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_lower"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.28" />

    <!-- LEVEL COMPLETE! w tym samym miejscu co poprzednio był LEVEL 1 -->
    <TextView
        android:id="@+id/tvLevel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/level_complete_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#666666"
        app:layout_constraintTop_toTopOf="@id/guideline_lower"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- correct / all (pod tvLevel) -->
    <TextView
        android:id="@+id/tvCorrect"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Correct: 7 / 10"
        android:textSize="16sp"
        android:gravity="center"
        android:textColor="#111111"
        app:layout_constraintTop_toBottomOf="@id/tvLevel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <!-- Guideline to position the buttons (możesz zmienić wartość percent aby przesunąć je wyżej/niżej) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.74" />

    <!-- Przyciski ułożone pionowo, zaczynają się przy guideline_buttons -->
    <Button
        android:id="@+id/btnTryAgain"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/try_again"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_rounded"
        app:layout_constraintTop_toTopOf="@id/guideline_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.8" />

    <Button
        android:id="@+id/btnMainMenu"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/main_menu"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_rounded"
        app:layout_constraintTop_toBottomOf="@id/btnTryAgain"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.8"
        android:layout_marginTop="12dp" />

</androidx.constraintlayout.widget.ConstraintLayout>